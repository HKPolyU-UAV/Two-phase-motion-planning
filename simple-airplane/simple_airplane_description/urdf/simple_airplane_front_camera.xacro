<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- +X is the aircraft nose; optical +Z points along the viewing direction. -->
  <xacro:macro name="fixed_front_camera" params="parent prefix:='' gazebo_sensor:=true">
    <joint name="${prefix}front_camera_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}front_camera_link"/>
      <origin xyz="0.03 0 0.015" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}front_camera_link">
      <visual name="front_camera_housing">
        <origin xyz="-0.03 0 0" rpy="0 0 0"/>
        <geometry><box size="0.04 0.05 0.04"/></geometry>
        <material name="FrontCameraHousing"><color rgba="0.12 0.12 0.12 1"/></material>
      </visual>
      <visual name="front_camera_lens">
        <origin xyz="-0.005 0 0" rpy="0 1.5707963267948966 0"/>
        <geometry><cylinder radius="0.012" length="0.01"/></geometry>
        <material name="FrontCameraLens"><color rgba="0.03 0.03 0.03 1"/></material>
      </visual>
    </link>
    <joint name="${prefix}front_camera_optical_joint" type="fixed">
      <parent link="${prefix}front_camera_link"/>
      <child link="${prefix}front_camera_optical_frame"/>
      <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
    </joint>
    <link name="${prefix}front_camera_optical_frame"/>
    <xacro:if value="${gazebo_sensor}">
      <gazebo reference="${prefix}front_camera_link">
        <material>Gazebo/Black</material>
      </gazebo>
      <!-- Attach to the existing massive link: no camera mass or collision is added. -->
      <gazebo reference="${parent}">
        <sensor name="front_camera" type="camera">
          <pose>0.03 0 0.015 0 0 0</pose>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <visualize>false</visualize>
          <camera name="front_camera">
            <horizontal_fov>1.5707963267948966</horizontal_fov>
            <image><width>640</width><height>360</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>300</far></clip>
          </camera>
          <plugin name="front_camera_controller" filename="libgazebo_ros_camera.so">
            <robotNamespace>/suav1</robotNamespace>
            <cameraName>front_camera</cameraName>
            <imageTopicName>image_raw</imageTopicName>
            <cameraInfoTopicName>camera_info</cameraInfoTopicName>
            <frameName>front_camera_optical_frame</frameName>
            <updateRate>15.0</updateRate>
          </plugin>
        </sensor>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
