<?xml version="1.0"?>
<launch>
<arg name="gazebo_dynamic_obstacles" default="true"/>
<arg name="primitive_config" default="$(find motion_primitives_planning)/launch/config/mp.yaml"/>
<arg name="task_config" default="$(find motion_primitives_planning)/launch/config/task.yaml"/>
<group ns="suav1">
<!-- Planning -->
    <rosparam command="load" file="$(arg primitive_config)" />
    <!-- Switching back to a task without spheres must clear the previous count. -->
    <param name="sphere_obstacles/num" value="0" type="int"/>
    <param name="horizontal_obstacles/num" value="0" type="int"/>
    <rosparam command="load" file="$(arg task_config)" />
    <node pkg="motion_primitives_planning" type="motion_primitives_test" name="mp_test" output="screen">
    </node>
    <!-- Mirror the planner's dynamic obstacle markers into Gazebo. -->
    <node if="$(arg gazebo_dynamic_obstacles)" pkg="motion_primitives_planning"
          type="gazebo_dynamic_obstacles.py" name="gazebo_dynamic_obstacles" output="screen" />

    <!-- Visual Model -->
    <arg name="model" default="$(find motion_primitives_planning)/launch/meshes/simple_airplane.urdf" />
    <param name="urdf_model" command="$(find xacro)/xacro --inorder $(arg model)" />
</group>

<!-- RViz -->
<arg name="rviz" default="true"/>
<arg name="rviz_config" default="$(find motion_primitives_planning)/launch/mp_test_3d.rviz"/>
<node if="$(arg rviz)" pkg="rviz" type="rviz" name="suav1_rviz" respawn="false" output="screen" args="-d $(arg rviz_config)" />
</launch>
