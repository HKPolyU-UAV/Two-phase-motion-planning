<?xml version="1.0"?>
<launch>
  <!-- The original 12-column / 3-moving-obstacle layout, using the current 3D planner. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="true"/>
  <include file="$(find simple_airplane_gazebo)/launch/simple_airplane_empty_world.launch">
    <arg name="world_name" value="$(find simple_airplane_gazebo)/worlds/obs.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>
  <include file="$(find motion_primitives_planning)/launch/motion_primitives_test.launch">
    <arg name="task_config" value="$(find motion_primitives_planning)/launch/config/task.yaml"/>
    <arg name="rviz_config" value="$(find motion_primitives_planning)/launch/mp_test_3d.rviz"/>
    <arg name="gazebo_dynamic_obstacles" value="true"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
</launch>
