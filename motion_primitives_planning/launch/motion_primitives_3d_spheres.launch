<?xml version="1.0"?>
<launch>
  <!-- Backward-compatible entry: the requested scene now uses horizontal rods. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="verify" default="true"/>
  <include file="$(find motion_primitives_planning)/launch/motion_primitives_3d_horizontal.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="rviz" value="$(arg rviz)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verify" value="$(arg verify)"/>
  </include>
</launch>
