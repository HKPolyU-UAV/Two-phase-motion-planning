<?xml version="1.0"?>
<launch>
  <!-- Long horizontal cylinders replace the floating spheres. -->
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="paused" default="true"/>
  <arg name="verify" default="true"/>
  <include file="$(find simple_airplane_gazebo)/launch/simple_airplane_empty_world.launch">
    <arg name="world_name" value="$(find simple_airplane_gazebo)/worlds/horizontal_obstacles.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
  </include>
  <include file="$(find motion_primitives_planning)/launch/motion_primitives_test.launch">
    <arg name="task_config" value="$(find motion_primitives_planning)/launch/config/task_3d_horizontal.yaml"/>
    <arg name="rviz_config" value="$(find motion_primitives_planning)/launch/mp_vertical_validation.rviz"/>
    <arg name="gazebo_dynamic_obstacles" value="true"/>
    <arg name="rviz" value="$(arg rviz)"/>
  </include>
  <param name="/suav1/motion_primitive/integration_dt" value="0.01"/>
  <group ns="suav1">
    <node if="$(arg verify)" pkg="motion_primitives_planning" type="verify_horizontal_avoidance.py"
          name="verify_horizontal_avoidance" output="screen"/>
  </group>
</launch>
